# ============ Stage 1: Build the React app ============
# Use Node to install dependencies and compile the app
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency files first (Docker caches this layer if unchanged)
COPY package*.json ./
RUN npm ci

# Copy source code and build
COPY . .

# Vite embeds VITE_* env vars at compile time (not runtime)
# Skip the app's built-in login page — Cloudflare Zero Trust handles auth
ENV VITE_DISABLE_AUTH=true

RUN npm run build
# After this, compiled static files are in /app/dist/

# ============ Stage 2: Serve with Nginx ============
# Use a lightweight Nginx image to serve the compiled files
FROM nginx:alpine

# Copy compiled files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy our nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Inject the backend API key at build time so the secret is never stored in
# source control (nginx.conf ships with the __BACKEND_API_KEY__ placeholder).
# Supplied via the API_KEY build arg (docker-compose.prod.yml reads it from .env).
# Build fails loudly if the arg is missing — better than shipping a broken auth gate.
# Strip CR/whitespace: a CRLF-saved .env makes compose pass "key\r", which bakes
# into nginx and then every clean browser X-API-Key fails with HTTP 403.
ARG API_KEY
RUN KEY="$(printf '%s' "$API_KEY" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')" \
    && test -n "$KEY" || (echo "ERROR: API_KEY build arg is required" >&2; exit 1) \
    && sed -i "s|__BACKEND_API_KEY__|${KEY}|g" /etc/nginx/conf.d/default.conf \
    && ! grep -q '__BACKEND_API_KEY__' /etc/nginx/conf.d/default.conf \
    || (echo "ERROR: placeholder not substituted" >&2; exit 1)

EXPOSE 80
