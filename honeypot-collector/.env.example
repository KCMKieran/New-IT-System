# Honeypot Collector configuration. Copy to `.env` and fill in real values.
# NEVER commit the real .env. This service holds NO database creds and NO
# internal-network access on purpose — the only secret it needs is SMTP.

# --- SMTP (the only external dependency) -------------------------------------
SMTP_SERVER=smtp.office365.com          # Outbound mail server (Office 365 default)
SMTP_PORT=587                           # STARTTLS submission port
SMTP_USERNAME=alerts@kohleservices.com  # Mailbox login; also used as the From address
SMTP_PASSWORD=change-me                 # Mailbox password / app password (SECRET)

# --- Webhook auth (Pattern B, embedded decoys) -------------------------------
# A long random string. Embedded decoys present it in the X-Honeypot-Secret
# header when POSTing to /collect. Generate with e.g. `openssl rand -hex 32`.
HONEYPOT_SHARED_SECRET=replace-with-a-long-random-string-openssl-rand-hex-32

# --- Alerting ----------------------------------------------------------------
HONEYPOT_ALERT_TO=it.support@kohleservices.com  # Where trip alerts are emailed

# --- Hosted decoys (Pattern A) id-gate ---------------------------------------
# Comma-separated "safe" ids. A request carrying one of these is treated as our
# own camouflage traffic (fake 200, no alert). Anything else trips an alert.
HONEYPOT_SAFE_IDS=136017

# --- Dedup / cooldown --------------------------------------------------------
COOLDOWN_MINUTES=5                       # Collapse same-source bursts into 1 email
