# Hand-made backups before editing a .env (e.g. .env.bak-20260812-113336).
# The bare `.env` rule above does NOT cover these, so a backup holding every
# production secret would otherwise sit in `git status` as untracked and be
# swept up by `git add -A`.
.env.bak*
*.env.bak*
__pycache__
*venv
*.venv
*.json
*.svg
*.txt
frontend/public/profit_last_refresh.txt
*.csv
*.xlsx
.agents
.cursor

# Backend logs (persisted locally, not in git)
backend/logs/*.log
backend/logs/*.log.*
!backend/logs/.gitkeep
backend/logs-prod/*.log.*
*.log

*.db
# SQLite WAL mode companion files (auto-created next to the .db)
*.db-wal
*.db-shm

# Runtime artifacts (flock files etc.) — created by the app at startup
.scheduler.lock

# One-off audit / report artifacts generated by backend/scripts/*
backend/scripts/login_ip_deep_audit_*.html

# One-off analysis HTML at project root (DB audits, page deep-dives, etc.)
/*-analysis.html

CLAUDE.md

# Local-only notes (sensitive: infra details / vulnerability map — keep off git)
SECURITY_VULNERABILITY_REVIEW.md
SSH_Tunnel_Configuration.md

# Project docs are local-only (history preserved via past commits, but no
# longer tracked going forward — keeps doc churn out of git log).
# To browse historical versions: git log --all -- docs/<path>
# NOTE: use `docs/**` not `docs/`. The trailing-slash form excludes the
# directory itself, making re-includes (`!docs/optimization/...`) impossible.
docs/**
# Exception: optimization tracker is committed so parallel Claude sessions
# can see each other's claims (see docs/optimization/README.md §并行 session 安全).
!docs/optimization
!docs/optimization/**
# Exception: docs portal ops doc — OPT-0026 needs this checked in so new
# deploys can read the portal's architecture/ops notes (the portal itself
# lives outside docs/, but its runbook belongs next to other operations/).
!docs/operations/
!docs/operations/docs-portal.md
# Pre-migration SQLite backups (created ad-hoc before risky schema changes)
backend/data/risk_monitor.db.bak-*

# Cross-deploy hashed-assets archive (built by scripts/archive-frontend-assets.sh
# during ./deploy.sh; bind-mounted read-only into the prod frontend container)
frontend/.assets-archive/
frontend/tsconfig.app.tsbuildinfo

# Nginx audit access log (bind-mounted into the prod web container).
# Whole directory, not just *.log: the `*.log` rule above cannot match
# logrotate archives such as access.log-2026-08-05.gz.
logs/nginx-prod/
.claude/settings.local.json
.claude/skills/
# Local AI-dev scratch notes / sharing exports (not project source)
Claude_CLI_Quick_Access_Summary.md
ai-dev-techniques-sharing.html

# Local-only scratch / data-exploration workspace (real client CSVs, internal
# logic notes, ad-hoc scripts) — never publish to the public repo.
temp_folder/
backend/scripts/zipcode_set_by_idlist.py
# Ad-hoc script run logs (contain client ids) — pattern, not per-file: the
# per-file form only ignored the 2026-06-04 run and leaked every later one.
backend/scripts/logs/*.jsonl
.local-backup/
