# Backend logs (persisted locally, not in git)
backend/logs/*.log
backend/logs/*.log.*
!backend/logs/.gitkeep
backend/logs-prod/*.log.*
*.log

*.db
# SQLite WAL mode companion files (auto-created next to the .db)
*.db-wal
*.db-shm

# Runtime artifacts (flock files etc.) — created by the app at startup
.scheduler.lock

# One-off audit / report artifacts generated by backend/scripts/*
backend/scripts/login_ip_deep_audit_*.html

# One-off analysis HTML at project root (DB audits, page deep-dives, etc.)
/*-analysis.html

CLAUDE.md

# Local-only notes (sensitive: infra details / vulnerability map — keep off git)
SECURITY_VULNERABILITY_REVIEW.md
SSH_Tunnel_Configuration.md

# Project docs are local-only (history preserved via past commits, but no
# longer tracked going forward — keeps doc churn out of git log).
# To browse historical versions: git log --all -- docs/<path>
# NOTE: use `docs/**` not `docs/`. The trailing-slash form excludes the
# directory itself, making re-includes (`!docs/optimization/...`) impossible.
docs/**
# Exception: optimization tracker is committed so parallel Claude sessions
# can see each other's claims (see docs/optimization/README.md §并行 session 安全).
!docs/optimization
!docs/optimization/**
# Pre-migration SQLite backups (created ad-hoc before risky schema changes)
backend/data/risk_monitor.db.bak-*
frontend/tsconfig.app.tsbuildinfo
.claude/settings.local.json
.claude/skills/
